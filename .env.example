# Получите на https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash

# Имя сессии pyrogram (создаст файл SESSION_NAME.session в SESSION_DIR)
SESSION_NAME=user_session
SESSION_DIR=/app/data

# Каналы-источники через запятую.
# Можно username (@channel), числовой id (-100...) или ссылку https://t.me/...
SOURCE_CHATS=@source_channel_1,@source_channel_2

# Куда пересылать
TARGET_CHAT_ID=-1001234567890

# ID темы (topic/thread). Оставьте пустым, если тема не нужна
TARGET_TOPIC_ID=123

# true/false
# true  => copy_message (в тему максимально надежно)
# false => raw forward (MTProto) с top_msg_id; при ошибке fallback на copy
COPY_MODE=false

# Расширенные логи входящих апдейтов (для диагностики)
DEBUG_UPDATES=false

# Резервная проверка новых постов по истории каналов (секунды)
POLL_INTERVAL_SECONDS=30

# Лог пишется в файл на смонтированном томе хоста
LOG_FILE=/app/logs/relay.log
